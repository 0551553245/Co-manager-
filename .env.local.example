# Supabase project settings → API. Safe to expose to the browser — data
# isolation is enforced by Postgres RLS (comanager-logic §3), not by
# hiding these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Recommended in production (e.g. https://comanager.app) so the owner
# registration confirmation-email link is built from a value this app
# controls, not request headers a client can influence. Optional locally —
# app/owner/register/actions.ts falls back to request headers when unset,
# which is fine for local dev.
NEXT_PUBLIC_SITE_URL=

# Server-only — never expose to the browser or commit a real value.
# Bypasses RLS entirely; reserved for future admin/service-role operations
# (e.g. Super Admin panel). Not wired into any client in this scaffold yet.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — server-only, used exclusively in lib/cloudinary/upload-photo.ts
# (a Server Action) to sign uploads. Never exposed to the browser; only the
# resulting secure_url is ever written to Supabase (comanager-context).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Server-only — the SAME value already set as a Supabase Edge Function
# secret for generate-daily-slots (see PENDING_MANUAL_STEPS.md §3.3). Used
# by lib/slots/generate-immediate-slot.ts to call that function's scoped
# mode right after an owner creates/reactivates a task or standard, so a
# manager sees today's slot immediately instead of waiting for the next
# midnight cron run (comanager-logic §4). Must match exactly — this is
# the same secret in a second place, not a different one.
CRON_SECRET=
